# MandiSetu — Local Development Environment
APP_NAME=MandiSetu
DEBUG=True
SECRET_KEY=local_dev_secret_change_in_production

# Database (matches docker-compose service)
DATABASE_URL=postgresql+asyncpg://mandisetu:mandisetu@localhost:5432/mandisetu_db
DATABASE_URL_SYNC=postgresql://mandisetu:mandisetu@localhost:5432/mandisetu_db

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs (get free keys from each service)
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Upload
UPLOAD_DIR=uploads
